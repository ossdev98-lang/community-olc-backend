# Ozone Lapcare Community Backend - Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.

NODE_ENV=development
PORT=5000

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=olc_community
DB_USER=olc_user
DB_PASSWORD=olc_pass123
# Or use a single DATABASE_URL (takes precedence if set)
# DATABASE_URL=postgresql://olc_user:olc_pass123@localhost:5432/olc_community

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_this_with_a_second_long_random_secret_in_production
JWT_REFRESH_EXPIRES_IN=30d

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880
MAX_IMAGES_PER_REQUIREMENT=5

# OTP / SMS provider (optional - not configured by default)
# SMS_PROVIDER=twilio
# SMS_API_KEY=your_sms_api_key
# SMS_API_SECRET=your_sms_api_secret
# SMS_FROM=OLC Community

# Expiry settings (hours)
DEFAULT_EXPIRY_HOURS=24
MAX_EXPIRY_HOURS=72
